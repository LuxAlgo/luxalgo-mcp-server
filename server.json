{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.LuxAlgo/luxalgo-mcp-server",
  "title": "LuxAlgo",
  "description": "Live Vela charts in your chat, plus the LuxAlgo Library, prop firm simulations and your own Vela",
  "repository": {
    "url": "https://github.com/LuxAlgo/luxalgo-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://www.luxalgo.com/mcp/",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/LuxAlgo/luxalgo-mcp-server/main/applications/openai/assets/logo.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "version": "2.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@luxalgo/mcp",
      "version": "2.1.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.luxalgo.com/mcp"
    }
  ]
}
