{
  // Typecheck-only config for the chart view (browser code bundled by
  // scripts/build-chart-view.mjs). Outside src/ so the server's tsc never sees DOM code.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["."]
}
