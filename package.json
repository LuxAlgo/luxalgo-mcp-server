{
  "name": "@luxalgo/mcp",
  "version": "1.3.0",
  "description": "LuxAlgo MCP server \u2014 the entire LuxAlgo ecosystem for AI agents: the Library encyclopedia of trading & technical analysis, prop-firm analysis (firms, challenges, live offers), and the open-source prop-firm challenge Monte Carlo simulator, and local read-only broker portfolio access through @luxalgo/broker-sdk, with more areas to come. Free and keyless.",
  "mcpName": "io.github.LuxAlgo/luxalgo-mcp-server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuxAlgo/luxalgo-mcp-server.git"
  },
  "type": "module",
  "bin": {
    "luxalgo-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "agents",
    "technical analysis",
    "technical indicators",
    "charting",
    "finance",
    "trading",
    "prop firms",
    "prop trading",
    "funded accounts",
    "trading challenges",
    "monte-carlo",
    "simulation",
    "research",
    "knowledge-base",
    "open-data",
    "claude",
    "ai",
    "broker",
    "brokerage",
    "portfolio"
  ],
  "author": "LuxAlgo",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke.mjs",
    "test:http": "node scripts/smoke.mjs --http http://localhost:3333/mcp",
    "test:parity": "node scripts/parity.mjs"
  },
  "dependencies": {
    "@luxalgo/broker-sdk": "^0.3.0",
    "@luxalgo/prop-firm-sim-core": "^1.0.0",
    "@luxalgo/prop-firm-sim-mcp": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "mcp-handler": "^1.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
