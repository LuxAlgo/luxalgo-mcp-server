{
  "name": "@luxalgo/mcp",
  "version": "2.1.0",
  "description": "Live Vela charts in your chat: open a chart from a sentence and change it by asking, on crypto and Hyperliquid's 24/7 stock perpetuals. Plus the LuxAlgo Library, session statistics and prop firm simulations, and, signed in, your own Vela (watchlists, saved layouts, the chart you have open) and Trade Journal. Local runs add read-only broker accounts. Never places trades.",
  "mcpName": "io.github.LuxAlgo/luxalgo-mcp-server",
  "homepage": "https://www.luxalgo.com/mcp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuxAlgo/luxalgo-mcp-server.git"
  },
  "type": "module",
  "bin": {
    "luxalgo-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "agents",
    "technical analysis",
    "technical indicators",
    "charting",
    "finance",
    "trading",
    "prop firms",
    "prop trading",
    "funded accounts",
    "trading challenges",
    "monte-carlo",
    "simulation",
    "research",
    "knowledge-base",
    "open-data",
    "claude",
    "ai",
    "broker",
    "brokerage",
    "portfolio",
    "congress trades",
    "insider trading",
    "sec edgar",
    "lobbying",
    "government contracts",
    "public records"
  ],
  "author": "LuxAlgo",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/entries/node-http.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "test": "node test/smoke.mjs",
    "test:http": "node test/smoke.mjs --http http://localhost:3333/mcp",
    "test:parity": "node test/parity.mjs",
    "test:trackers": "node test/trackers-check.mjs",
    "build:chart": "tsc -p view/chart/tsconfig.json && node scripts/build-chart-view.mjs",
    "vercel-build": "npm run build && npm run build:chart"
  },
  "dependencies": {
    "@luxalgo/broker-sdk": "^0.5.0",
    "@luxalgo/prop-firm-sim-core": "1.2.1",
    "@luxalgo/prop-firm-sim-mcp": "1.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@posthog/mcp": "^0.13.0",
    "jose": "^6.2.12",
    "mcp-handler": "^2.1.1",
    "posthog-node": "^5.51.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@luxalgo/vela": "0.10.2",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
