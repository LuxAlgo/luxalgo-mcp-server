{
  "name": "@luxalgo/mcp",
  "version": "1.1.0",
  "description": "LuxAlgo MCP server — the entire LuxAlgo ecosystem for AI agents: the Library encyclopedia of trading & technical analysis, plus prop-firm analysis (firms, challenges, live offers), with more areas to come. Free and keyless.",
  "mcpName": "io.github.LuxAlgo/luxalgo-mcp-server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuxAlgo/luxalgo-mcp-server.git"
  },
  "type": "module",
  "bin": {
    "luxalgo-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "agents",
    "technical analysis",
    "technical indicators",
    "charting",
    "finance",
    "trading",
    "prop firms",
    "prop trading",
    "funded accounts",
    "trading challenges",
    "research",
    "knowledge-base",
    "open-data",
    "claude",
    "ai"
  ],
  "author": "LuxAlgo",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke.mjs",
    "test:http": "node scripts/smoke.mjs --http http://localhost:3333/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "mcp-handler": "^1.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
